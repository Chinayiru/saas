server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/saas_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: ${DB_PASSWORD}   # 从环境变量读取，不要提交真实密码
  data:
    redis:
      host: localhost
      port: 6379

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl   # 开发期打印 SQL

app:
  jwt:
    secret: ${JWT_SECRET:change-this-secret-to-a-long-random-string-2026}
    expire-minutes: 120
